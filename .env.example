VITE_DOCUMENT_SERVICE_URL=http://localhost:3002/api/v1
VITE_AGENT_SERVICE_URL=http://localhost:3003/api/v1
VITE_QUERY_SERVICE_URL=http://localhost:3004/api/v1
VITE_AUTOMATION_SERVICE_URL=http://localhost:3007/api/v1
VITE_NOTIFICATION_SERVICE_URL=http://localhost:3009/api/v1
VITE_NOTIFICATION_WS_URL=ws://localhost:3009/notifications
VITE_INTEGRATION_SERVICE_URL=http://localhost:3008/api/v1
VITE_AUDIT_SERVICE_URL=http://localhost:3010/api/v1

